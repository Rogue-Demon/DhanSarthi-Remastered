# ============================================================
# DhanSarthi Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env or any file containing real credentials.
# ============================================================

# Application
APP_NAME=DhanSarthi API
APP_ENV=development

# Database
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# For local development, create a PostgreSQL database named 'dhansarthi'.
# pgvector will be required for RAG — install it via your
# PostgreSQL package manager or use the pgvector Docker image.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dhansarthi

# Connection Pooling (optional — defaults are suitable for development)
# Increase pool_size and max_overflow for production workloads.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Authentication secret — generate a strong random value for production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ============================================================
# AI Advisor Configuration
# ============================================================

# LLM Provider
# Options: "mock" (safe default for dev), "huggingface" (production)
AI_PROVIDER=mock

# Required when AI_PROVIDER=huggingface — your HuggingFace API token
# Obtain from: https://huggingface.co/settings/tokens
AI_PROVIDER_API_KEY=

# The HuggingFace Inference API model ID to use
AI_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# AI generation parameters
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

# Timeout in seconds for a single LLM request — returns HTTP 504 if exceeded
AI_REQUEST_TIMEOUT_SECONDS=60

# Number of recent conversation messages to include as context
AI_MAX_HISTORY_MESSAGES=20

# Maximum input message length in characters (user input guard)
AI_MAX_MESSAGE_LENGTH=2000

# ============================================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================================

# Number of knowledge chunks to retrieve per query
RAG_TOP_K=5

# Minimum cosine similarity score (0.0–1.0) to include a chunk
RAG_SIMILARITY_THRESHOLD=0.3

# Maximum token budget for RAG context injected into the prompt
RAG_MAX_CONTEXT_TOKENS=2000

# Chunk size and overlap for document ingestion
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ============================================================
# Embedding Configuration (used by pgvector RAG)
# ============================================================

# Options: "mock" (safe default for dev), "huggingface" (production)
EMBEDDING_PROVIDER=mock

# Required when EMBEDDING_PROVIDER=huggingface — HuggingFace API token
EMBEDDING_PROVIDER_API_KEY=

# Sentence-transformer model used for embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Output vector dimension — must match pgvector column dimension
EMBEDDING_DIMENSION=384

# ============================================================
# Market Data Configuration (Phase C)
# ============================================================

# Alpha Vantage API key for stock quotes and FX rates
# Obtain from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ============================================================
# Document Storage (Phase E)
# ============================================================

# Cloud storage bucket name for document uploads
STORAGE_BUCKET=
