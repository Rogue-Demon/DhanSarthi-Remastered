# ============================================================
# DhanSarthi Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env or any file containing real credentials.
# ============================================================

APP_NAME=DhanSarthi API
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dhansarthi
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=

# ============================================================
# AI Advisor Configuration
# ============================================================
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_MESSAGE_LENGTH=2000

# ============================================================
# AI Provider — Streaming / L.9.8
# ============================================================
# Master switch. Keep false until live provider streaming is validated.
AI_STREAMING_ENABLED=false
# Preferred client behavior when streaming is enabled.
AI_STREAMING_DEFAULT=true
# L.9.8 streaming-first policy flag.
AI_STREAMING_FIRST_ENABLED=true
# Allow frontend to fall back to POST /messages when streaming is unavailable.
AI_STREAMING_FALLBACK_ENABLED=true
# Optional keepalive cadence for long-running SSE connections.
AI_STREAMING_HEARTBEAT_SECONDS=15.0
# Hard upper bound for one streaming request.
AI_STREAMING_MAX_DURATION_SECONDS=90

# ============================================================
# AI Provider — HTTP Connection Pool
# ============================================================
AI_HTTP_MAX_CONNECTIONS=20
AI_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
AI_HTTP_KEEPALIVE_SECONDS=30.0

# ============================================================
# AI Provider — Retry Policy
# ============================================================
AI_MAX_RETRIES=1

# ============================================================
# RAG
# ============================================================
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_TOKENS=2000
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ============================================================
# Embedding
# ============================================================
EMBEDDING_PROVIDER=mock
EMBEDDING_PROVIDER_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ============================================================
# Market Data
# ============================================================
ALPHA_VANTAGE_API_KEY=

# ============================================================
# Document Storage
# ============================================================
STORAGE_BUCKET=

# ============================================================
# Adaptive LLM Inference Optimization — Phase L.7.4
# ============================================================
AI_ADAPTIVE_INFERENCE_ENABLED=true
AI_SIMPLE_MAX_TOKENS=256
AI_MODERATE_MAX_TOKENS=512
AI_COMPLEX_MAX_TOKENS=768
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_RAG_CONTEXT_CHARS=7000
AI_MAX_PERSONAL_CONTEXT_CHARS=4000
AI_MAX_HISTORY_CHARS=5000

# ============================================================
# Real-Time LLM Inference & Model Selection — Phase L.8
# ============================================================
AI_MODEL_ROUTING_ENABLED=false
AI_FAST_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
AI_BALANCED_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
AI_REASONING_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
AI_ALLOWED_MODELS=meta-llama/Meta-Llama-3-8B-Instruct,meta-llama/Llama-3.2-1B-Instruct,meta-llama/Llama-3.2-3B-Instruct,Qwen/Qwen2.5-7B-Instruct
AI_TOKENIZER_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Phase L.9.4 — Provider readiness diagnostic fallback model
AI_PROVIDER_READINESS_FALLBACK_MODEL=
