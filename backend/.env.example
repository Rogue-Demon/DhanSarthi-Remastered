# ============================================================
# DhanSarthi Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env or any file containing real credentials.
# ============================================================

# Application
APP_NAME=DhanSarthi API
APP_ENV=development

# Database
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# For local development, create a PostgreSQL database named 'dhansarthi'.
# pgvector will be required for RAG — install it via your
# PostgreSQL package manager or use the pgvector Docker image.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dhansarthi

# Connection Pooling (optional — defaults are suitable for development)
# Increase pool_size and max_overflow for production workloads.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Authentication secret — generate a strong random value for production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# ============================================================
# AI Advisor Configuration
# ============================================================

# LLM Provider
# Options: "mock" (safe default for dev), "huggingface" (production)
AI_PROVIDER=mock

# Required when AI_PROVIDER=huggingface — your HuggingFace API token
# Obtain from: https://huggingface.co/settings/tokens
AI_PROVIDER_API_KEY=

# The HuggingFace Inference API model ID to use
AI_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# AI generation parameters
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

# Timeout in seconds for a single LLM request — returns HTTP 504 if exceeded
AI_REQUEST_TIMEOUT_SECONDS=60

# Number of recent conversation messages to include as context
AI_MAX_HISTORY_MESSAGES=20

# Maximum input message length in characters (user input guard)
AI_MAX_MESSAGE_LENGTH=2000

# Streaming configuration (Phase L.7.3 & L.9.5)
# AI_STREAMING_ENABLED: Master switch for SSE token streaming (default false)
# AI_STREAMING_DEFAULT: Preferred mode for clients when streaming is enabled (default true)
AI_STREAMING_ENABLED=false
AI_STREAMING_DEFAULT=true

# ============================================================
# AI Provider — HTTP Connection Pool (Phase L.7.3)
# ============================================================

# Maximum total outbound HTTP connections to HuggingFace API (0 = unlimited).
# Increase for high-concurrency production deployments.
AI_HTTP_MAX_CONNECTIONS=20

# Maximum idle keep-alive connections to reuse (reduces TCP handshake overhead).
AI_HTTP_MAX_KEEPALIVE_CONNECTIONS=10

# Idle keep-alive connection expiry in seconds.
AI_HTTP_KEEPALIVE_SECONDS=30.0

# ============================================================
# AI Provider — Retry Policy (Phase L.7.3)
# ============================================================

# Number of retry attempts for transient failures (HTTP 502, 503, 504, connection errors).
# Set to 0 to disable retries. Never retries on 401, 403, 429.
# Each retry uses exponential backoff with jitter (base=0.5s, max=10s).
AI_MAX_RETRIES=1

# ============================================================
# AI Provider — Streaming (Phase L.7.3)
# ============================================================

# Enable SSE streaming for the /ai/conversations/{id}/stream endpoint.
# When false (default), the /stream endpoint returns HTTP 501.
# When true, text chunks stream to the frontend while the full response is
# safety-validated and persisted before the stream ends.
# Requires HuggingFace Router SSE support for the configured model.
AI_STREAMING_ENABLED=false

# ============================================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================================

# Number of knowledge chunks to retrieve per query
RAG_TOP_K=5

# Minimum cosine similarity score (0.0–1.0) to include a chunk
RAG_SIMILARITY_THRESHOLD=0.3

# Maximum token budget for RAG context injected into the prompt
RAG_MAX_CONTEXT_TOKENS=2000

# Chunk size and overlap for document ingestion
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ============================================================
# Embedding Configuration (used by pgvector RAG)
# ============================================================

# Options: "mock" (safe default for dev), "huggingface" (production)
EMBEDDING_PROVIDER=mock

# Required when EMBEDDING_PROVIDER=huggingface — HuggingFace API token
EMBEDDING_PROVIDER_API_KEY=

# Sentence-transformer model used for embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Output vector dimension — must match pgvector column dimension
EMBEDDING_DIMENSION=384

# ============================================================
# Market Data Configuration (Phase C)
# ============================================================

# Alpha Vantage API key for stock quotes and FX rates
# Obtain from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ============================================================
# Document Storage (Phase E)
# ============================================================

# Cloud storage bucket name for document uploads
STORAGE_BUCKET=

# ============================================================
# Adaptive LLM Inference Optimization (Phase L.7.4)
# ============================================================

# Enables adaptive output token budgets, context trimming, and history limits
AI_ADAPTIVE_INFERENCE_ENABLED=true

# Output token budgets by complexity tier
AI_SIMPLE_MAX_TOKENS=256
AI_MODERATE_MAX_TOKENS=512
AI_COMPLEX_MAX_TOKENS=768

# Prompt component character ceilings for input workload control
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_RAG_CONTEXT_CHARS=7000
AI_MAX_PERSONAL_CONTEXT_CHARS=4000
AI_MAX_HISTORY_CHARS=5000

# ============================================================
# Real-Time LLM Inference Optimization & Model Selection (Phase L.8)
# ============================================================

# Controls whether dynamic model selection is enabled (default false)
AI_MODEL_ROUTING_ENABLED=false

# Configured model candidates per complexity tier
AI_FAST_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
AI_BALANCED_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
AI_REASONING_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Trusted allowlist of server-approved model IDs
AI_ALLOWED_MODELS=meta-llama/Meta-Llama-3-8B-Instruct,meta-llama/Llama-3.2-1B-Instruct,meta-llama/Llama-3.2-3B-Instruct,Qwen/Qwen2.5-7B-Instruct
AI_TOKENIZER_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Phase L.9.4 — Production Provider Readiness & Real Inference Validation
# Optional explicitly configured fallback model for diagnostic readiness validation (default empty)
AI_PROVIDER_READINESS_FALLBACK_MODEL=
