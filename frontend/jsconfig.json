{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@pages": ["./src/pages"],
      "@pages/*": ["./src/pages/*"],
      "@layouts": ["./src/layouts"],
      "@layouts/*": ["./src/layouts/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],
      "@config": ["./src/config"],
      "@config/*": ["./src/config/*"],
      "@assets": ["./src/assets"],
      "@assets/*": ["./src/assets/*"],
      "@styles": ["./src/styles"],
      "@styles/*": ["./src/styles/*"],
      "@routes": ["./src/routes"],
      "@routes/*": ["./src/routes/*"],
      "@types": ["./src/types"],
      "@types/*": ["./src/types/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
